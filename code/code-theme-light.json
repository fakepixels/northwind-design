{
  "name": "northwind-light",
  "type": "light",
  "colors": {
    "editor.background": "#f6f4f1",
    "editor.foreground": "#0c0a08"
  },
  "tokenColors": [
    {
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#736e69",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "keyword",
        "storage",
        "storage.type",
        "storage.modifier",
        "keyword.control",
        "keyword.operator.new",
        "keyword.operator.expression",
        "entity.name.tag",
        "support.class.component"
      ],
      "settings": {
        "foreground": "#613f1d"
      }
    },
    {
      "scope": [
        "string",
        "string.quoted",
        "string.template",
        "punctuation.definition.string",
        "markup.inline.raw"
      ],
      "settings": {
        "foreground": "#21763c"
      }
    },
    {
      "scope": [
        "constant.numeric",
        "constant.language",
        "constant.character",
        "support.constant",
        "variable.other.constant"
      ],
      "settings": {
        "foreground": "#925000"
      }
    },
    {
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "support.type",
        "support.class",
        "entity.other.inherited-class"
      ],
      "settings": {
        "foreground": "#646904"
      }
    },
    {
      "scope": [
        "entity.name.function",
        "support.function",
        "meta.function-call"
      ],
      "settings": {
        "foreground": "#0c0a08"
      }
    },
    {
      "scope": [
        "variable.parameter",
        "variable.other.property",
        "meta.object-literal.key",
        "entity.other.attribute-name",
        "support.type.property-name"
      ],
      "settings": {
        "foreground": "#0c0a08"
      }
    },
    {
      "scope": [
        "punctuation",
        "meta.brace",
        "keyword.operator",
        "punctuation.separator",
        "punctuation.terminator"
      ],
      "settings": {
        "foreground": "#736e69"
      }
    }
  ]
}
